# Public web configuration (never put the TURN shared secret here)
PUBLIC_ORIGIN=http://localhost:5173
PUBLIC_SIGNAL_URL=ws://localhost:3001/signal
PUBLIC_MAX_FILE_BYTES=536870912

# Signaling-only configuration
SIGNAL_HOST=127.0.0.1
SIGNAL_PORT=3001
SIGNAL_ALLOWED_ORIGINS=http://localhost:5173
SIGNAL_MAX_CONNECTIONS=1000
SIGNAL_MAX_QUEUE_SIZE=500
SIGNAL_MAX_MESSAGE_BYTES=65536
SIGNAL_QUEUE_TIMEOUT_MS=120000
SIGNAL_SESSION_TIMEOUT_MS=900000
SIGNAL_HEARTBEAT_MS=20000

# TURN credentials are minted server-side; use deployment secrets for these values.
TURN_URLS=turn:turn.example.com:3478?transport=udp
STUN_URLS=stun:stun.example.com:3478
TURN_SHARED_SECRET=replace-in-local-environment-only
# Container deployments should prefer TURN_SHARED_SECRET_FILE=/run/secrets/turn_shared_secret.
TURN_CREDENTIAL_TTL_SECONDS=600
